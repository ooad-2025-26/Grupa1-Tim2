@model IEnumerable<ETFTalentProgram.Models.Log>

@{
    ViewData["Title"] = "Pregled logova";

    static TimeZoneInfo GetSarajevoTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Central European Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Sarajevo");
        }
    }

    var sarajevoTimeZone = GetSarajevoTimeZone();

    string FormatLocalTime(DateTime value)
    {
        var utcValue = value.Kind == DateTimeKind.Utc
            ? value
            : DateTime.SpecifyKind(value, DateTimeKind.Utc);
        return TimeZoneInfo.ConvertTimeFromUtc(utcValue, sarajevoTimeZone).ToString("dd.MM.yyyy HH:mm:ss");
    }
}

<h1>Pregled logova</h1>

<form asp-action="Index" method="get" class="row gy-2 gx-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="tipAkcije" class="form-label">Tip akcije</label>
        <select id="tipAkcije" name="tipAkcije" class="form-select" asp-items="ViewBag.TipoviAkcija">
            <option value="">Svi logovi</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtriraj</button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">Resetuj</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TipAkcije)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VrijemeAkcije)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KorisnikId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Detalji)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nivo)
            </th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TipAkcije)
            </td>
            <td>
                @FormatLocalTime(item.VrijemeAkcije)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KorisnikId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Detalji)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nivo)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Detalji</a>
            </td>
        </tr>
}
    </tbody>
</table>
