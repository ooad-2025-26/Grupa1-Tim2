@model ETFTalentProgram.Models.Log

@{
    ViewData["Title"] = "Detalji loga";

    static TimeZoneInfo GetSarajevoTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Central European Standard Time");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Sarajevo");
        }
    }

    var sarajevoTimeZone = GetSarajevoTimeZone();
    var utcVrijeme = Model.VrijemeAkcije.Kind == DateTimeKind.Utc
        ? Model.VrijemeAkcije
        : DateTime.SpecifyKind(Model.VrijemeAkcije, DateTimeKind.Utc);
    var lokalnoVrijeme = TimeZoneInfo.ConvertTimeFromUtc(utcVrijeme, sarajevoTimeZone);
}

<h1>Detalji loga</h1>

<div>
    <h4>Log</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipAkcije)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipAkcije)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VrijemeAkcije)
        </dt>
        <dd class = "col-sm-10">
            @lokalnoVrijeme.ToString("dd.MM.yyyy HH:mm:ss")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.KorisnikId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KorisnikId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Detalji)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Detalji)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nivo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nivo)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Nazad na pregled logova</a>
</div>
